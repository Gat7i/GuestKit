# ----------------------------
# SUPABASE CREDENTIALS
# ----------------------------
# 1. Tableau de bord Supabase : Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key_ici
# ⚠️ Clé secrète — ne jamais exposer côté client ni commiter
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key_ici

# ----------------------------
# CLOUDINARY CREDENTIALS
# ----------------------------
# 2. Tableau de bord Cloudinary : Account Details > API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=votre_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=votre_upload_preset

# ----------------------------
# HOTEL
# ----------------------------
# 3. ID de l'hôtel dans la table hotels (généralement 1 par instance)
NEXT_PUBLIC_HOTEL_ID=1

# ----------------------------
# SITE (optionnel)
# ----------------------------
# 4. URL publique du site — utilisée pour le sitemap (Vercel l'auto-détecte en prod)
NEXT_PUBLIC_SITE_URL=https://www.guestskit.app
